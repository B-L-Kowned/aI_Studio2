PORT=3633
# The address collaborators open — the consent page's public origin.
PUBLIC_URL=https://consent.example.com
# Shared with the studio (backend CONSENT_TOKEN). 24+ random characters.
STUDIO_TOKEN=change-me-to-a-long-random-string
# Resend, for the invite email. Without them, invites are created and the link is copied by hand.
RESEND_API_KEY=
MAIL_FROM=Studio <invites@example.com>
DB_PATH=./data/consent.db
