{
  "name": "ai-video-studio-desktop",
  "version": "0.1.0",
  "description": "AI Video Studio — desktop shell",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build:web": "cd ../frontend && npm run build",
    "dist": "npm run build:web && electron-builder"
  },
  "devDependencies": {
    "electron": "^44.4.5",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "com.bialkowned.aivideostudio",
    "productName": "AI Video Studio",
    "directories": {
      "output": "release"
    },
    "files": [
      "main.js",
      "preload.js",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "../backend",
        "to": "app/backend",
        "filter": [
          "**/*",
          "!**/.env",
          "!**/.env.*",
          "!**/credentials.key",
          "!**/*.db",
          "!**/*.db-wal",
          "!**/*.db-shm",
          "!**/*.db-journal",
          "!verify*.mjs",
          "!run-verify.mjs",
          "!scripts/**/*.py",
          "!**/node_modules/.cache{,/**}"
        ]
      },
      {
        "from": "../frontend/dist",
        "to": "app/frontend/dist"
      }
    ],
    "mac": {
      "category": "public.app-category.video",
      "target": [
        "dmg"
      ]
    },
    "win": {
      "target": [
        "nsis"
      ]
    },
    "linux": {
      "target": [
        "AppImage"
      ]
    }
  }
}
