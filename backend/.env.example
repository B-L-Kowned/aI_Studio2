PORT=3433
CORS_ORIGIN=http://localhost:3333

# Database location. Defaults to the OS user-data directory; override for tests.
# STUDIO_DB_PATH=/tmp/studio.db

# How far provider calls are allowed to go.
#   fixtures   nothing leaves this machine. Deterministic stand-ins. (default)
#   live_read  real catalogue reads — your avatars, voices, quota.
#              Generation stays simulated, so nothing can be billed.
#   live       generation is real and billable. A paid render still needs
#              explicit confirmation in the UI.
PROVIDER_MODE=fixtures

# Legacy switch, still honoured: true -> fixtures, false -> live.
# PROVIDER_MODE wins when both are set.
DRY_RUN=true

# Override only if you are pointing at a mock or a regional endpoint.
# HEYGEN_API_BASE=https://api.heygen.com
